# Future configuration template. Not required by the minimal dev server.
# Configure real values when the corresponding backlog tasks are implemented.
ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./data/viewport.db

# Optional until photo uploads are implemented. Never prefix credentials with PUBLIC_.
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

MAX_FILE_SIZE_BYTES=26214400
USER_STORAGE_QUOTA_BYTES=10737418240
MAX_GALLERY_ZIP_BYTES=2147483648
UPLOAD_RESERVATION_TTL_SECONDS=1800
PROCESSING_CONCURRENCY=2
MAX_UPLOAD_BATCH_FILES=100
MAX_IMAGE_PIXELS=40000000
MAX_CONCURRENT_ZIP_DOWNLOADS=2
