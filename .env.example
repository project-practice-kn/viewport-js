# Минимальному dev-серверу .env не нужен. Для SeaweedFS заполните S3-параметры.
# Остальные параметры понадобятся при реализации соответствующих задач.
ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=./data/viewport.db

# Локальный SeaweedFS. Замените примеры ключей в .env перед запуском Compose.
# Не добавляйте к credentials префикс PUBLIC_.
S3_REGION=us-east-1
S3_BUCKET=viewport-local
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE_BYTES=26214400
USER_STORAGE_QUOTA_BYTES=10737418240
MAX_GALLERY_ZIP_BYTES=2147483648
UPLOAD_RESERVATION_TTL_SECONDS=1800
PROCESSING_CONCURRENCY=2
MAX_UPLOAD_BATCH_FILES=100
MAX_IMAGE_PIXELS=40000000
MAX_CONCURRENT_ZIP_DOWNLOADS=2
