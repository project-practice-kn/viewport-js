# Скопировать в .env в корне репозитория на TrueNAS, затем выполнить setup-env.mjs.
VIEWPORT_HOST=calendar.samuraj.su
VIEWPORT_HTTPS_PORT=4443
VIEWPORT_IMAGE=viewport-calendar:truenas
VIEWPORT_DATA_ROOT=/mnt/tank/apps/viewport

# Уже работающий Traefik.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=le

# setup-env.mjs заменит шаблоны случайными значениями, не выводя их в лог.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
REGISTRATION_INVITE_CODE=replace-with-a-random-invite-code
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
S3_BUCKET=viewport-demo

# Начальные ограничения контейнеров для демо. Квота файла/пользователя задана в Compose.
VIEWPORT_APP_MEMORY=2g
VIEWPORT_APP_CPUS=2
VIEWPORT_S3_MEMORY=1g
VIEWPORT_S3_CPUS=2
