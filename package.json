{
  "name": "viewport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run format:check && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@better-auth/drizzle-adapter": "1.7.10",
    "archiver": "8.0.0",
    "better-auth": "1.7.10",
    "better-sqlite3": "13.0.3",
    "bulma": "1.0.4",
    "drizzle-orm": "0.45.4",
    "sharp": "0.35.5",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
