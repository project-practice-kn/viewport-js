FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm --mount=type=secret,id=npm_ca \
    if [ -f /run/secrets/npm_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/npm_ca; fi; \
    npm ci --ignore-scripts --no-audit --no-fund --fetch-retries=4 --prefer-offline --maxsockets=5
COPY . .
RUN --mount=type=secret,id=npm_ca \
    if [ -f /run/secrets/npm_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/npm_ca; fi; \
    npm rebuild better-sqlite3 esbuild && chown -R node:node /app
USER node
EXPOSE 3000
CMD ["sh", "-c", "node scripts/migrate.ts && node scripts/setup-s3.ts && npm run dev -- --host 0.0.0.0 --port 3000 --strictPort"]
